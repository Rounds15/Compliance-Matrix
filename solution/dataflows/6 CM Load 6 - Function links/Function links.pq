// Function links -> su_functionlink, in dataflow "CM Load 6 - Function links". Generated by tools/build_dataflows.py.
// One time: loads function-links-import.csv (the HECA additional links) from the site's Documents library.
// Paste into Get data > Blank query > Advanced editor, replacing everything, and name the query "Function links".
let
    Files = SharePoint.Files("https://sumailsyr.sharepoint.com/sites/SyracuseComplianceMatrix", [ApiVersion = 15]),
    File = Table.SelectRows(Files, each [Name] = "function-links-import.csv"),
    Csv = if Table.RowCount(File) = 1
        then Csv.Document(File{0}[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])
        else error ("Put function-links-import.csv in the site's Documents library; found " & Text.From(Table.RowCount(File)) & " files of that name"),
    Rows = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
    // each su_function GUID becomes the function's Legacy SharePoint ID, the key the lookup binds through
    Functions = CommonDataService.Database("org999d244d.crm.dynamics.com"){[Schema = "dbo", Item = "su_compliancefunction"]}[Data],
    Keys = Table.Buffer(Table.TransformColumns(Table.SelectColumns(Functions, {"su_compliancefunctionid", "su_legacyspid"}),
        {{"su_compliancefunctionid", each Text.Lower(Text.From(_)), type text}})),
    Types = [Statute = 100000140, Regulation = 100000141, Guidance = 100000142, #"SU Resource" = 100000143],
    Link = (r as record) as record =>
        let
            id = Text.Lower(Text.Trim(r[su_function])),
            hit = Table.SelectRows(Keys, each [su_compliancefunctionid] = id),
            spid = if Table.RowCount(hit) = 1 and hit{0}[su_legacyspid] <> null then hit{0}[su_legacyspid]
                else error ("Function " & id & " (" & r[su_functionname] & ") is not in Dataverse, or has no Legacy SharePoint ID"),
            kind = Record.FieldOrDefault(Types, Text.Trim(r[su_linktype]), null),
            url = Text.Trim(r[su_url])
        in [
            su_name = Text.Start(Text.Trim(r[su_name]), 400),
            #"su_function.su_legacyspid" = spid,
            su_url = if Text.StartsWith(url, "https://") then Text.Start(url, 2000) else error ("Not an https:// address: " & url),
            su_linktype = if kind = null then error ("Unknown link type: " & r[su_linktype]) else kind,
            su_sortorder = Int64.From(r[su_sortorder]),
            su_source = Text.Start(Text.Trim(r[su_source]), 200)
        ],
    Result = Table.FromRecords(List.Transform(Table.ToRecords(Rows), Link),
        type table [su_name = text, #"su_function.su_legacyspid" = Int64.Type, su_url = text,
            su_linktype = Int64.Type, su_sortorder = Int64.Type, su_source = text])
in
    Result
