{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "su_CMDataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365users": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "su_CMOffice365Users"
        },
        "api": {
          "name": "shared_office365users"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "su_CMOffice365Outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Try": {
          "type": "Scope",
          "actions": {
            "List_sign_ins": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "adx_externalidentities",
                  "$filter": "@{concat('adx_identityprovidername eq ', concat('''', replace('https://sts.windows.net/4278a402-1a9e-4eb9-8414-ffb55a5fcf1e/', '''', ''''''), ''''))}",
                  "$select": "adx_externalidentityid,adx_username,_adx_contactid_value"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "For_each_sign_in": {
              "type": "Foreach",
              "foreach": "@body('List_sign_ins')?['value']",
              "actions": {
                "Get_Entra_user": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365users",
                      "operationId": "UserProfile_V2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users"
                    },
                    "parameters": {
                      "id": "@{items('For_each_sign_in')?['adx_username']}",
                      "$select": "id,displayName,userPrincipalName,mail,accountEnabled,userType"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Found_in_Entra": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@equals(actions('Get_Entra_user')?['status'], 'Succeeded')",
                          true
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Is_a_member": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@and(equals(body('Get_Entra_user')?['userType'], 'Member'), equals(body('Get_Entra_user')?['accountEnabled'], true))",
                              true
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Find_directory_row": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "su_compliancedirectorys",
                              "$filter": "@{concat('(su_email eq ', concat('''', replace(toLower(coalesce(body('Get_Entra_user')?['userPrincipalName'], '')), '''', ''''''), ''''), if(empty(toLower(coalesce(body('Get_Entra_user')?['mail'], ''))), '', concat(' or su_email eq ', concat('''', replace(toLower(coalesce(body('Get_Entra_user')?['mail'], '')), '''', ''''''), ''''))), ') and su_active eq true')}",
                              "$select": "su_compliancedirectoryid,su_name,su_email,_su_contact_value",
                              "$top": 2
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {}
                        },
                        "Find_rows_linked_to_contact": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_commondataserviceforapps",
                              "operationId": "ListRecords",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                            },
                            "parameters": {
                              "entityName": "su_compliancedirectorys",
                              "$filter": "@{concat('_su_contact_value eq ', items('For_each_sign_in')?['_adx_contactid_value'])}",
                              "$select": "su_compliancedirectoryid",
                              "$top": 2
                            },
                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {
                            "Find_directory_row": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Safe_to_link": {
                          "type": "Compose",
                          "inputs": "@if(equals(length(body('Find_directory_row')?['value']), 0), 'none', if(greater(length(body('Find_directory_row')?['value']), 1), 'ambiguous', if(equals(toLower(coalesce(first(body('Find_directory_row')?['value'])?['_su_contact_value'], '')), toLower(items('For_each_sign_in')?['_adx_contactid_value'])), 'already', if(not(empty(coalesce(first(body('Find_directory_row')?['value'])?['_su_contact_value'], ''))), 'moved', if(greater(length(body('Find_rows_linked_to_contact')?['value']), 0), 'elsewhere', 'link')))))",
                          "runAfter": {
                            "Find_rows_linked_to_contact": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Link_or_tell_the_office": {
                          "type": "Switch",
                          "expression": "@outputs('Safe_to_link')",
                          "cases": {
                            "Link": {
                              "case": "link",
                              "actions": {
                                "Set_Portal_Contact": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_commondataserviceforapps",
                                      "operationId": "UpdateRecord",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                    },
                                    "parameters": {
                                      "entityName": "su_compliancedirectorys",
                                      "recordId": "@{first(body('Find_directory_row')?['value'])?['su_compliancedirectoryid']}",
                                      "item/su_contact@odata.bind": "@{concat('contacts(', items('For_each_sign_in')?['_adx_contactid_value'], ')')}"
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  },
                                  "runAfter": {}
                                }
                              }
                            },
                            "Already_linked": {
                              "case": "already",
                              "actions": {}
                            },
                            "Not_in_the_directory": {
                              "case": "none",
                              "actions": {
                                "Get_auto_create_url": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_commondataserviceforapps",
                                      "operationId": "ListRecords",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                    },
                                    "parameters": {
                                      "entityName": "mspp_sitesettings",
                                      "$filter": "@{concat('mspp_name eq ', concat('''', replace('ComplianceMatrix/Flow/DirectoryCreate', '''', ''''''), ''''))}",
                                      "$select": "mspp_sitesettingid,mspp_name,mspp_value",
                                      "$top": 1
                                    },
                                    "authentication": "@parameters('$authentication')"
                                  },
                                  "runAfter": {}
                                },
                                "Auto_create_is_set_up": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@startsWith(toLower(trim(coalesce(first(body('Get_auto_create_url')?['value'])?['mspp_value'], ''))), 'https://')",
                                          true
                                        ]
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Call_Directory_Auto_Create": {
                                      "type": "Http",
                                      "inputs": {
                                        "method": "POST",
                                        "uri": "@{trim(coalesce(first(body('Get_auto_create_url')?['value'])?['mspp_value'], ''))}",
                                        "headers": {
                                          "Content-Type": "application/json"
                                        },
                                        "body": {
                                          "contactId": "@{items('For_each_sign_in')?['_adx_contactid_value']}"
                                        }
                                      },
                                      "runAfter": {}
                                    },
                                    "Auto_create_failed": {
                                      "type": "If",
                                      "expression": {
                                        "and": [
                                          {
                                            "equals": [
                                              "@not(equals(actions('Call_Directory_Auto_Create')?['status'], 'Succeeded'))",
                                              true
                                            ]
                                          }
                                        ]
                                      },
                                      "actions": {
                                        "Tell_the_office_not_in_directory_after_call": {
                                          "type": "OpenApiConnection",
                                          "inputs": {
                                            "host": {
                                              "connectionName": "shared_office365",
                                              "operationId": "SendEmailV2",
                                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                            },
                                            "parameters": {
                                              "emailMessage/To": "SyracuseComplianceMatrix@groups.syr.edu",
                                              "emailMessage/Subject": "Compliance Matrix: a sign-in is not linked to the directory",
                                              "emailMessage/Body": "@{concat('<p>A sign-in to the Compliance Matrix site could not be linked to the Compliance Directory, so the person cannot act on functions in the matrix yet.</p><p><b>Why:</b> ', if(equals(outputs('Safe_to_link'), 'none'), 'No active Compliance Directory row has this person''s user principal name or mail address as its email. Add them to the directory, or correct their directory email to their NetID address.', if(equals(outputs('Safe_to_link'), 'ambiguous'), 'Their user principal name and their mail address match two different Compliance Directory rows. Correct the row that is not theirs.', if(equals(outputs('Safe_to_link'), 'moved'), 'The Compliance Directory row with their email is already linked to a different contact. Check which contact is right, then change Portal Contact on the row by hand.', 'This contact is already linked to a different Compliance Directory row. Check which row is right, then change Portal Contact by hand.'))), '</p><ul><li>Name: ', coalesce(body('Get_Entra_user')?['displayName'], ''), '</li><li>User principal name: ', coalesce(body('Get_Entra_user')?['userPrincipalName'], ''), '</li><li>Mail: ', coalesce(body('Get_Entra_user')?['mail'], ''), '</li><li>Contact ID: ', items('For_each_sign_in')?['_adx_contactid_value'], '</li></ul><p>Run: ', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name']), '</p>')}",
                                              "emailMessage/Importance": "Normal"
                                            },
                                            "authentication": "@parameters('$authentication')"
                                          },
                                          "runAfter": {}
                                        }
                                      },
                                      "else": {
                                        "actions": {}
                                      },
                                      "runAfter": {
                                        "Call_Directory_Auto_Create": [
                                          "Succeeded",
                                          "Failed",
                                          "TimedOut"
                                        ]
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Tell_the_office_not_in_directory": {
                                        "type": "OpenApiConnection",
                                        "inputs": {
                                          "host": {
                                            "connectionName": "shared_office365",
                                            "operationId": "SendEmailV2",
                                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                          },
                                          "parameters": {
                                            "emailMessage/To": "SyracuseComplianceMatrix@groups.syr.edu",
                                            "emailMessage/Subject": "Compliance Matrix: a sign-in is not linked to the directory",
                                            "emailMessage/Body": "@{concat('<p>A sign-in to the Compliance Matrix site could not be linked to the Compliance Directory, so the person cannot act on functions in the matrix yet.</p><p><b>Why:</b> ', if(equals(outputs('Safe_to_link'), 'none'), 'No active Compliance Directory row has this person''s user principal name or mail address as its email. Add them to the directory, or correct their directory email to their NetID address.', if(equals(outputs('Safe_to_link'), 'ambiguous'), 'Their user principal name and their mail address match two different Compliance Directory rows. Correct the row that is not theirs.', if(equals(outputs('Safe_to_link'), 'moved'), 'The Compliance Directory row with their email is already linked to a different contact. Check which contact is right, then change Portal Contact on the row by hand.', 'This contact is already linked to a different Compliance Directory row. Check which row is right, then change Portal Contact by hand.'))), '</p><ul><li>Name: ', coalesce(body('Get_Entra_user')?['displayName'], ''), '</li><li>User principal name: ', coalesce(body('Get_Entra_user')?['userPrincipalName'], ''), '</li><li>Mail: ', coalesce(body('Get_Entra_user')?['mail'], ''), '</li><li>Contact ID: ', items('For_each_sign_in')?['_adx_contactid_value'], '</li></ul><p>Run: ', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name']), '</p>')}",
                                            "emailMessage/Importance": "Normal"
                                          },
                                          "authentication": "@parameters('$authentication')"
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Get_auto_create_url": [
                                      "Succeeded"
                                    ]
                                  }
                                }
                              }
                            }
                          },
                          "default": {
                            "actions": {
                              "Tell_the_office": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "connectionName": "shared_office365",
                                    "operationId": "SendEmailV2",
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                  },
                                  "parameters": {
                                    "emailMessage/To": "SyracuseComplianceMatrix@groups.syr.edu",
                                    "emailMessage/Subject": "Compliance Matrix: a sign-in is not linked to the directory",
                                    "emailMessage/Body": "@{concat('<p>A sign-in to the Compliance Matrix site could not be linked to the Compliance Directory, so the person cannot act on functions in the matrix yet.</p><p><b>Why:</b> ', if(equals(outputs('Safe_to_link'), 'none'), 'No active Compliance Directory row has this person''s user principal name or mail address as its email. Add them to the directory, or correct their directory email to their NetID address.', if(equals(outputs('Safe_to_link'), 'ambiguous'), 'Their user principal name and their mail address match two different Compliance Directory rows. Correct the row that is not theirs.', if(equals(outputs('Safe_to_link'), 'moved'), 'The Compliance Directory row with their email is already linked to a different contact. Check which contact is right, then change Portal Contact on the row by hand.', 'This contact is already linked to a different Compliance Directory row. Check which row is right, then change Portal Contact by hand.'))), '</p><ul><li>Name: ', coalesce(body('Get_Entra_user')?['displayName'], ''), '</li><li>User principal name: ', coalesce(body('Get_Entra_user')?['userPrincipalName'], ''), '</li><li>Mail: ', coalesce(body('Get_Entra_user')?['mail'], ''), '</li><li>Contact ID: ', items('For_each_sign_in')?['_adx_contactid_value'], '</li></ul><p>Run: ', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name']), '</p>')}",
                                    "emailMessage/Importance": "Normal"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {}
                              }
                            }
                          },
                          "runAfter": {
                            "Safe_to_link": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Is_a_guest": {
                            "type": "If",
                            "expression": {
                              "and": [
                                {
                                  "equals": [
                                    "@and(equals(body('Get_Entra_user')?['userType'], 'Guest'), equals(body('Get_Entra_user')?['accountEnabled'], true))",
                                    true
                                  ]
                                }
                              ]
                            },
                            "actions": {
                              "Guest_Get_auto_create_url": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "connectionName": "shared_commondataserviceforapps",
                                    "operationId": "ListRecords",
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                  },
                                  "parameters": {
                                    "entityName": "mspp_sitesettings",
                                    "$filter": "@{concat('mspp_name eq ', concat('''', replace('ComplianceMatrix/Flow/DirectoryCreate', '''', ''''''), ''''))}",
                                    "$select": "mspp_sitesettingid,mspp_name,mspp_value",
                                    "$top": 1
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {}
                              },
                              "Guest_Auto_create_is_set_up": {
                                "type": "If",
                                "expression": {
                                  "and": [
                                    {
                                      "equals": [
                                        "@startsWith(toLower(trim(coalesce(first(body('Guest_Get_auto_create_url')?['value'])?['mspp_value'], ''))), 'https://')",
                                        true
                                      ]
                                    }
                                  ]
                                },
                                "actions": {
                                  "Guest_Call_Directory_Auto_Create": {
                                    "type": "Http",
                                    "inputs": {
                                      "method": "POST",
                                      "uri": "@{trim(coalesce(first(body('Guest_Get_auto_create_url')?['value'])?['mspp_value'], ''))}",
                                      "headers": {
                                        "Content-Type": "application/json"
                                      },
                                      "body": {
                                        "contactId": "@{items('For_each_sign_in')?['_adx_contactid_value']}"
                                      }
                                    },
                                    "runAfter": {}
                                  },
                                  "Guest_Auto_create_failed": {
                                    "type": "If",
                                    "expression": {
                                      "and": [
                                        {
                                          "equals": [
                                            "@not(equals(actions('Guest_Call_Directory_Auto_Create')?['status'], 'Succeeded'))",
                                            true
                                          ]
                                        }
                                      ]
                                    },
                                    "actions": {},
                                    "else": {
                                      "actions": {}
                                    },
                                    "runAfter": {
                                      "Guest_Call_Directory_Auto_Create": [
                                        "Succeeded",
                                        "Failed",
                                        "TimedOut"
                                      ]
                                    }
                                  }
                                },
                                "else": {
                                  "actions": {}
                                },
                                "runAfter": {
                                  "Guest_Get_auto_create_url": [
                                    "Succeeded"
                                  ]
                                }
                              }
                            },
                            "else": {
                              "actions": {}
                            },
                            "runAfter": {}
                          }
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "No_account_Get_auto_create_url": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_commondataserviceforapps",
                            "operationId": "ListRecords",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                          },
                          "parameters": {
                            "entityName": "mspp_sitesettings",
                            "$filter": "@{concat('mspp_name eq ', concat('''', replace('ComplianceMatrix/Flow/DirectoryCreate', '''', ''''''), ''''))}",
                            "$select": "mspp_sitesettingid,mspp_name,mspp_value",
                            "$top": 1
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "No_account_Auto_create_is_set_up": {
                        "type": "If",
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@startsWith(toLower(trim(coalesce(first(body('No_account_Get_auto_create_url')?['value'])?['mspp_value'], ''))), 'https://')",
                                true
                              ]
                            }
                          ]
                        },
                        "actions": {
                          "No_account_Call_Directory_Auto_Create": {
                            "type": "Http",
                            "inputs": {
                              "method": "POST",
                              "uri": "@{trim(coalesce(first(body('No_account_Get_auto_create_url')?['value'])?['mspp_value'], ''))}",
                              "headers": {
                                "Content-Type": "application/json"
                              },
                              "body": {
                                "contactId": "@{items('For_each_sign_in')?['_adx_contactid_value']}"
                              }
                            },
                            "runAfter": {}
                          },
                          "No_account_Auto_create_failed": {
                            "type": "If",
                            "expression": {
                              "and": [
                                {
                                  "equals": [
                                    "@not(equals(actions('No_account_Call_Directory_Auto_Create')?['status'], 'Succeeded'))",
                                    true
                                  ]
                                }
                              ]
                            },
                            "actions": {
                              "Tell_the_office_no_account_after_call": {
                                "type": "OpenApiConnection",
                                "inputs": {
                                  "host": {
                                    "connectionName": "shared_office365",
                                    "operationId": "SendEmailV2",
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                  },
                                  "parameters": {
                                    "emailMessage/To": "SyracuseComplianceMatrix@groups.syr.edu",
                                    "emailMessage/Subject": "Compliance Matrix: a sign-in is not linked to the directory",
                                    "emailMessage/Body": "@{concat('<p>A sign-in to the Compliance Matrix site has no matching Microsoft Entra account, so it was not linked to the Compliance Directory.</p><ul><li>Contact: ', coalesce(items('For_each_sign_in')?['_adx_contactid_value@OData.Community.Display.V1.FormattedValue'], ''), '</li><li>Contact ID: ', items('For_each_sign_in')?['_adx_contactid_value'], '</li><li>External Identity username: ', items('For_each_sign_in')?['adx_username'], '</li></ul><p>If the username is not the person''s Entra object ID, the site stores the sub claim instead (docs/DATAVERSE-MIGRATION.md, section 6).</p><p>Run: ', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name']), '</p>')}",
                                    "emailMessage/Importance": "Normal"
                                  },
                                  "authentication": "@parameters('$authentication')"
                                },
                                "runAfter": {}
                              }
                            },
                            "else": {
                              "actions": {}
                            },
                            "runAfter": {
                              "No_account_Call_Directory_Auto_Create": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                              ]
                            }
                          }
                        },
                        "else": {
                          "actions": {
                            "Tell_the_office_no_account": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_office365",
                                  "operationId": "SendEmailV2",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                },
                                "parameters": {
                                  "emailMessage/To": "SyracuseComplianceMatrix@groups.syr.edu",
                                  "emailMessage/Subject": "Compliance Matrix: a sign-in is not linked to the directory",
                                  "emailMessage/Body": "@{concat('<p>A sign-in to the Compliance Matrix site has no matching Microsoft Entra account, so it was not linked to the Compliance Directory.</p><ul><li>Contact: ', coalesce(items('For_each_sign_in')?['_adx_contactid_value@OData.Community.Display.V1.FormattedValue'], ''), '</li><li>Contact ID: ', items('For_each_sign_in')?['_adx_contactid_value'], '</li><li>External Identity username: ', items('For_each_sign_in')?['adx_username'], '</li></ul><p>If the username is not the person''s Entra object ID, the site stores the sub claim instead (docs/DATAVERSE-MIGRATION.md, section 6).</p><p>Run: ', concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name']), '</p>')}",
                                  "emailMessage/Importance": "Normal"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            }
                          }
                        },
