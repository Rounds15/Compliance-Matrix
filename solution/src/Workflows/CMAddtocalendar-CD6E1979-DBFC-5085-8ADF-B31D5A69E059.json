                            "authentication": "@parameters('$authentication')"
                          },
                          "runAfter": {
                            "File_name": [
                              "Succeeded"
                            ]
                          }
                        },
                        "New_or_existing": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@equals(length(body('Find_invite')?['value']), 0)",
                                  true
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Send_invitation": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_office365",
                                  "operationId": "SendEmailV2",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                                },
                                "parameters": {
                                  "emailMessage/From": "SyracuseComplianceMatrix@groups.syr.edu",
                                  "emailMessage/To": "@{trim(coalesce(first(body('Find_person')?['value'])?['su_email'], ''))}",
                                  "emailMessage/Subject": "@{outputs('Subject')}",
                                  "emailMessage/Body": "@{concat('<p><b>', coalesce(first(body('Find_function')?['value'])?['su_name'], ''), '</b></p><p>', concat('Due date: ', trim(string(coalesce(items('For_each_deadline')?['due'], '')))), '</p><p>', replace(coalesce(first(body('Find_function')?['value'])?['su_deadlinenarrative'], ''), decodeUriComponent('%0A'), '<br>'), '</p>', if(empty(if(startsWith(toLower(trim(string(coalesce(outputs('Read_deadlines')?['page'], '')))), 'https://'), concat(first(split(trim(string(coalesce(outputs('Read_deadlines')?['page'], ''))), '#')), '#/functions/', first(body('Find_function')?['value'])?['su_compliancefunctionid']), '')), '', concat('<p><a href=\"', if(startsWith(toLower(trim(string(coalesce(outputs('Read_deadlines')?['page'], '')))), 'https://'), concat(first(split(trim(string(coalesce(outputs('Read_deadlines')?['page'], ''))), '#')), '#/functions/', first(body('Find_function')?['value'])?['su_compliancefunctionid']), ''), '\">Open this function in the Compliance Matrix</a></p>')))}",
                                  "emailMessage/Importance": "Normal",
                                  "emailMessage/Attachments": [
                                    {
                                      "Name": "@{concat(outputs('File_name'), '.ics')}",
                                      "ContentBytes": "@{base64(concat('BEGIN:VCALENDAR', decodeUriComponent('%0D%0A'), 'VERSION:2.0', decodeUriComponent('%0D%0A'), 'PRODID:-//Syracuse University//Compliance Matrix//EN', decodeUriComponent('%0D%0A'), 'METHOD:REQUEST', decodeUriComponent('%0D%0A'), 'BEGIN:VEVENT', decodeUriComponent('%0D%0A'), concat('UID:', concat('cm-', trim(string(coalesce(items('For_each_deadline')?['id'], ''))), '-', toLower(body('Get_action')?['_su_requestedby_value']), '@syr.edu')), decodeUriComponent('%0D%0A'), concat('SEQUENCE:', string(0)), decodeUriComponent('%0D%0A'), concat('DTSTAMP:', utcNow('yyyyMMddTHHmmssZ')), decodeUriComponent('%0D%0A'), concat('DTSTART;VALUE=DATE:', replace(trim(string(coalesce(items('For_each_deadline')?['due'], ''))), '-', '')), decodeUriComponent('%0D%0A'), concat('DTEND;VALUE=DATE:', replace(addDays(trim(string(coalesce(items('For_each_deadline')?['due'], ''))), 1, 'yyyy-MM-dd'), '-', '')), decodeUriComponent('%0D%0A'), concat('SUMMARY:', replace(replace(replace(replace(replace(coalesce(outputs('Subject'), ''), decodeUriComponent('%0D'), ''), '\\', '\\\\'), ';', '\\;'), ',', '\\,'), decodeUriComponent('%0A'), '\\n')), decodeUriComponent('%0D%0A'), concat('DESCRIPTION:', replace(replace(replace(replace(replace(coalesce(concat(coalesce(first(body('Find_function')?['value'])?['su_name'], ''), decodeUriComponent('%0A'), concat('Due date: ', trim(string(coalesce(items('For_each_deadline')?['due'], '')))), if(empty(coalesce(first(body('Find_function')?['value'])?['su_deadlinenarrative'], '')), '', concat(decodeUriComponent('%0A%0A'), coalesce(first(body('Find_function')?['value'])?['su_deadlinenarrative'], ''))), if(empty(if(startsWith(toLower(trim(string(coalesce(outputs('Read_deadlines')?['page'], '')))), 'https://'), concat(first(split(trim(string(coalesce(outputs('Read_deadlines')?['page'], ''))), '#')), '#/functions/', first(body('Find_function')?['value'])?['su_compliancefunctionid']), '')), '', concat(decodeUriComponent('%0A%0A'), 'Open this function in the Compliance Matrix: ', if(startsWith(toLower(trim(string(coalesce(outputs('Read_deadlines')?['page'], '')))), 'https://'), concat(first(split(trim(string(coalesce(outputs('Read_deadlines')?['page'], ''))), '#')), '#/functions/', first(body('Find_function')?['value'])?['su_compliancefunctionid']), '')))), ''), decodeUriComponent('%0D'), ''), '\\', '\\\\'), ';', '\\;'), ',', '\\,'), decodeUriComponent('%0A'), '\\n')), decodeUriComponent('%0D%0A'), 'ORGANIZER;CN=Syracuse University Compliance Matrix:mailto:SyracuseComplianceMatrix@groups.syr.edu', decodeUriComponent('%0D%0A'), concat('ATTENDEE;ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=FALSE:mailto:', trim(coalesce(first(body('Find_person')?['value'])?['su_email'], ''))), decodeUriComponent('%0D%0A'), 'TRANSP:TRANSPARENT', decodeUriComponent('%0D%0A'), 'X-MICROSOFT-CDO-BUSYSTATUS:FREE', decodeUriComponent('%0D%0A'), 'X-MICROSOFT-CDO-ALLDAYEVENT:TRUE', decodeUriComponent('%0D%0A'), 'BEGIN:VALARM', decodeUriComponent('%0D%0A'), 'ACTION:DISPLAY', decodeUriComponent('%0D%0A'), 'DESCRIPTION:Reminder', decodeUriComponent('%0D%0A'), 'TRIGGER:-PT10080M', decodeUriComponent('%0D%0A'), 'END:VALARM', decodeUriComponent('%0D%0A'), 'END:VEVENT', decodeUriComponent('%0D%0A'), 'END:VCALENDAR', decodeUriComponent('%0D%0A'), ''))}"
                                    }
                                  ]
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {}
                            },
                            "Record_invitation": {
                              "type": "OpenApiConnection",
                              "inputs": {
                                "host": {
                                  "connectionName": "shared_commondataserviceforapps",
                                  "operationId": "CreateRecord",
                                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                                },
                                "parameters": {
                                  "entityName": "su_calendarinvites",
                                  "item/su_name": "@substring(concat(outputs('Subject'), ' | ', trim(coalesce(first(body('Find_person')?['value'])?['su_email'], ''))), 0, min(400, length(concat(outputs('Subject'), ' | ', trim(coalesce(first(body('Find_person')?['value'])?['su_email'], ''))))))",
                                  "item/su_sequence": 0,
                                  "item/su_duedatesent": "@{trim(string(coalesce(items('For_each_deadline')?['due'], '')))}",
                                  "item/su_email": "@{trim(coalesce(first(body('Find_person')?['value'])?['su_email'], ''))}",
                                  "item/su_senton": "@{utcNow()}",
                                  "item/su_deadline@odata.bind": "@{concat('su_compliancedeadlines(', trim(string(coalesce(items('For_each_deadline')?['id'], ''))), ')')}",
                                  "item/su_contact@odata.bind": "@{concat('contacts(', body('Get_action')?['_su_requestedby_value'], ')')}"
                                },
                                "authentication": "@parameters('$authentication')"
                              },
                              "runAfter": {
                                "Send_invitation": [
                                  "Succeeded"
                                ]
                              }
                            },
                            "Count_added": {
                              "type": "IncrementVariable",
                              "inputs": {
                                "name": "Added",
                                "value": 1
                              },
                              "runAfter": {
                                "Record_invitation": [
                                  "Succeeded"
                                ]
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Same_date": {
                                "type": "If",
                                "expression": {
                                  "and": [
