        "Try": {
          "type": "Scope",
          "actions": {
            "Read_request": {
              "type": "SetVariable",
              "inputs": {
                "name": "ActionId",
                "value": "@{coalesce(json(if(empty(string(triggerBody())), '{}', string(triggerBody())))?['actionId'], '')}"
              },
