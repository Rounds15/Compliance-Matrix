ClearCollect(
    dsFunctions,
    {su_compliancefunctionid: "2", su_functioncode: "2", su_name: "Academic Programs Prohibition of Discrimination", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A001", su_name: "Academic Programs"}, su_risk: "High", su_statute: "Age Discrimination Act of 1975", su_citation: "42 U.S. Code § 6102 - Prohibition of discrimination", su_statuteurl: "https://www.law.cornell.edu/uscode/text/42/6102", su_description: "Prohibits discrimination based on age in educational or academic programs or activities that receive federal financial assistance.   	Prohibits retaliation for filing a complaint with OCR or participating in a mediation or investigation of a violation, or for advocating for a right protected by the Act.", su_reporting: "", su_deadlinenarrative: "", su_resourcelabel: "Non-Discrimination and Equal Opportunity Policy Statement", su_resourceurl: "https://policies.syr.edu/policies/university-governance-ethics-integrity-and-legal-compliance/non-discrimination-and-equal-opportunity-policy-statement/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "jmhasenw@syr.edu", su_name: "Julie Hasenwinkel", su_email: "jmhasenw@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 2, su_nextduedate: DateAdd(Today(), -40, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: true},
    {su_compliancefunctionid: "3", su_functioncode: "3", su_name: "Clock-to-Credit Hour Conversion", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A001", su_name: "Academic Programs"}, su_risk: "Moderate", su_statute: "Higher Education Act", su_citation: "34 CFR § 668.8 - Eligible program", su_statuteurl: "https://www.law.cornell.edu/cfr/text/34/668.8", su_description: "For programs measured in clock hours that are converted to credit hours for Title IV purposes, institutions must follow the federal conversion formula. Institutions offering non-standard term or non-credit programs that receive Title IV aid must document that their credit hours are equivalent to federally-defined clock hours. Miscalculation is a common audit finding that can result in overborrowin", su_reporting: "Clock-to-credit hour conversion ratios must be documented and certified. State licensing body approval of conversions required where applicable. Reviewed during program approval and recertification.", su_deadlinenarrative: "At program creation or modification. Recertified during PPA renewal.", su_resourcelabel: "Credit Hours Policy", su_resourceurl: "https://policies.syr.edu/policies/faculty-teaching-and-research/classclassroom-scheduling-and-contact-hours-policy/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "kmnieder@syr.edu", su_name: "Kelly Campbell", su_email: "kmnieder@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: {su_compliancedirectoryid: "kmrupert@syr.edu", su_name: "Katie Rupert", su_email: "kmrupert@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 1, su_nextduedate: DateAdd(Today(), -17, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "4", su_functioncode: "4", su_name: "University Art Collections", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A001", su_name: "Academic Programs"}, su_risk: "Low", su_statute: "Visual Artists Rights Act", su_citation: "17 U.S.C. § 106A", su_statuteurl: "https://www.law.cornell.edu/uscode/text/17/106A", su_description: "Protects moral rights for fine art works, but does not protect audiovisual works and probably does not apply to most multimedia creations.", su_reporting: "No periodic external reporting required. Prior to removing or destroying a work of visual art incorporated into a building, the institution must make a good-faith attempt to notify the artist 90 days in advance.", su_deadlinenarrative: "90-day advance notice to artist before removal or destruction of work incorporated into building", su_resourcelabel: "Arts at Syracuse University", su_resourceurl: "https://www.syracuse.edu/campus-life/arts/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: Blank(), su_complianceowner: {su_compliancedirectoryid: "mstraudt@syr.edu", su_name: "Miranda Traudt", su_email: "mstraudt@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 6, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "6", su_functioncode: "6", su_name: "Non-Discrimination in Admissions", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A002", su_name: "Admissions, Title IV"}, su_risk: "", su_statute: "Age Discrimination Act of 1975", su_citation: "42 U.S. Code § 6102 - Prohibition of discrimination", su_statuteurl: "https://www.law.cornell.edu/uscode/text/42/6102", su_description: "Prohibits discrimination based on age in the admission of educational and/or academic programs or activities that receive federal financial assistance.   	Prohibits retaliation for filing a complaint with OCR or for advocating for a right protected by the Act.", su_reporting: "", su_deadlinenarrative: "", su_resourcelabel: "Non-Discrimination Policy", su_resourceurl: "https://policies.syr.edu/policies/university-governance-ethics-integrity-and-legal-compliance/non-discrimination-and-equal-opportunity-policy-statement/", su_executiveowner: Blank(), su_unitowner: {su_compliancedirectoryid: "maharr17@syr.edu", su_name: "Maurice Harris", su_email: "maharr17@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 29, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "7", su_functioncode: "7", su_name: "Readmission Requirements for Servicemembers", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A002", su_name: "Admissions, Title IV"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "20 U.S. Code § 1091c - Readmission requirements for servicemembers", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1091c", su_description: "Requires that the University readmit students who left in order to join the military. The student must be readmitted in the same academic status. Generally, the length of absence cannot be greater than five (5) years. Exceptions to this law include those veterans receiving a dishonorable discharge or bad conduct charge, those who were court marshaled, and those who the University is reasonably una", su_reporting: "Institutions must readmit servicemembers who leave due to military service and provide them with the same financial aid they had before departure. No periodic external filing; process documented internally.", su_deadlinenarrative: "", su_resourcelabel: "Readmission - Student Experience", su_resourceurl: "https://experience.syracuse.edu/student-outreach/student-support/readmission/", su_executiveowner: Blank(), su_unitowner: {su_compliancedirectoryid: "maharr17@syr.edu", su_name: "Maurice Harris", su_email: "maharr17@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 52, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: true},
    {su_compliancefunctionid: "8", su_functioncode: "8", su_name: "Accessibility in Admissions", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A002", su_name: "Admissions, Title IV"}, su_risk: "", su_statute: "Section 504 of The Rehabilitation Act of 1973", su_citation: "29 U.S. Code § 794 - Nondiscrimination under Federal grants and programs", su_statuteurl: "https://www.law.cornell.edu/uscode/text/29/794", su_description: "Prohibits discrimination on the basis of disability at any federally-funded institution. This covers admissions, recruitment, educational and/or academic programs and services, housing and non-academic programs and services such as counseling, placement, physical education and athletics, student clubs and organizations. This list is not exhaustive.", su_reporting: "", su_deadlinenarrative: "", su_resourcelabel: "Non-Discrimination on Basis of Disability", su_resourceurl: "https://policies.syr.edu/policies/university-governance-ethics-integrity-and-legal-compliance/non-discrimination-on-the-basis-of-disability-policy-statement/", su_executiveowner: Blank(), su_unitowner: {su_compliancedirectoryid: "maharr17@syr.edu", su_name: "Maurice Harris", su_email: "maharr17@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 75, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "9", su_functioncode: "9", su_name: "Sex Discrimination in Admissions", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A002", su_name: "Admissions, Title IV"}, su_risk: "", su_statute: "Title IX of the Education Amendment of 1972", su_citation: "20 U.S.C. § 1681; 34 C.F.R. Part 106", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1681", su_description: "Prohibits discrimination on the basis of sex in the admission of education programs or activities receiving federal financial assistance including employment.   	Under the Title IX common rule, a recipient may not discriminate against any person on the basis of sex in the counseling or guidance of students or applicants for admission. Specifically, in appraising or counseling students, a recipient", su_reporting: "", su_deadlinenarrative: "", su_resourcelabel: "Title IX - Syracuse University", su_resourceurl: "https://www.syracuse.edu/title-ix/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: Blank(), su_complianceowner: {su_compliancedirectoryid: "maharr17@syr.edu", su_name: "Maurice Harris", su_email: "maharr17@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 98, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "10", su_functioncode: "10", su_name: "Annual Consumer Information Notice", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "20 U.S. Code § 1092 - Institutional and financial assistance information for students", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1092", su_description: "Each school must make available to prospective and enrolled students:   	Names of associations, agencies, or governmental bodies that accredit, approve, or license the school and its programs; and   	Procedures for obtaining or reviewing documents describing accreditation, approval, or licensing.      20 U.S.C. § 1092(a)(1)(J); 34 CFR 668.43  Requires institutions to provide each student, upon enr", su_reporting: "Institution must submit periodic self-studies and host on-site evaluations as required by MSCHE. Material changes (new programs, campuses, governance changes) require advance notification and approval.  Same consumer information disclosure requirements as Academic Programs row. Admissions must provi", su_deadlinenarrative: "Per MSCHE schedule: comprehensive evaluation every 8 years; annual institutional updates; material change notifications as they occur  October 1 annually (no deadline mandated; suggested)", su_resourcelabel: "Consumer Information", su_resourceurl: "https://www.syracuse.edu/consumer-information/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: Blank(), su_complianceowner: {su_compliancedirectoryid: "lalvut@syr.edu", su_name: "Laura Harrington", su_email: "lalvut@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 121, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "11", su_functioncode: "11", su_name: "Consumer Information - Copyright Infringement & Penalties", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "HEA § 485(a)(1); 34 C.F.R. § 668.43", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1092", su_description: "Requires the following disclosures to enrolled students: (a) Policies/sanctions for copyright infringement; and (b) annual disclosure detailing federal copyright penalties.", su_reporting: "No deadline is mandated, but September 1 is suggested.", su_deadlinenarrative: "September 1 annually (suggested; no deadline mandated)", su_resourcelabel: "Consumer Information", su_resourceurl: "https://www.syracuse.edu/consumer-information/", su_executiveowner: {su_compliancedirectoryid: "jhrubin@syr.edu", su_name: "Jeff Rubin", su_email: "jhrubin@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "essedore@syr.edu", su_name: "Eric Sedore", su_email: "essedore@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: {su_compliancedirectoryid: "ccroad@syr.edu", su_name: "Christopher Croad", su_email: "ccroad@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 144, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "12", su_functioncode: "12", su_name: "Financial Value Transparency & Gainful Employment", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "34 CFR Part 668 - Subpart Q - Financial Value Transparency", su_statuteurl: "https://www.law.cornell.edu/cfr/text/34/part-668/subpart-Q", su_description: "To be Title IV eligible, an educational program must either lead to a degree awarded by a public or nonprofit institution or prepare students for gainful employment (GE) in a recognized occupation.  Thus, GE programs are non-degree programs at public and nonprofit institutions, and essentially all programs at proprietary institutions.", su_reporting: "Effective July 1, 2024, U.S. Department of Education regulations went into effect with the stated goal of addressing concerns related to student loan debt in virtually all academic programs that offer Title IV Federal Student Aid to students—both GE and “non-GE” programs—the latter being degree prog", su_deadlinenarrative: "September 30 annually (per Dept of Education schedule, first report September 30, 2025); ongoing as specified by Dept of Education", su_resourcelabel: "Consumer Information", su_resourceurl: "https://www.syracuse.edu/consumer-information/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: Blank(), su_complianceowner: {su_compliancedirectoryid: "jmhasenw@syr.edu", su_name: "Julie Hasenwinkel", su_email: "jmhasenw@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 167, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "13", su_functioncode: "13", su_name: "Information Distributed to Students", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "34 CFR § 668.41 - Reporting and disclosure of information", su_statuteurl: "https://www.law.cornell.edu/cfr/text/34/668.41", su_description: "Institutions participating in Title IV programs may be subject to fine, limitation, suspension, or termination of participation for violations of the Higher Education Act or applicable regulations. The Department of Education may impose these sanctions for non-compliance with program requirements, misuse of Title IV funds, or failure to maintain institutional eligibility.", su_reporting: "No deadline for disclosures to enrolled students is set, but September 1 is suggested.", su_deadlinenarrative: "September 1 annually (no deadline mandated; suggested)", su_resourcelabel: "Consumer Information - Syracuse University", su_resourceurl: "https://www.syracuse.edu/consumer-information/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "jmhasenw@syr.edu", su_name: "Julie Hasenwinkel", su_email: "jmhasenw@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 190, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "14", su_functioncode: "14", su_name: "Misrepresentation", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "HEA § 487; 20 U.S.C. § 1094", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1094", su_description: "Makes the institution responsible for substantial misrepresentations made by the institution itself, a representative of the institution, or any person or entity with whom the institution has an agreement to provide educational programs, marketing, advertising, and recruiting or admissions services.   	Broadens the definitions of misrepresentations of the nature of an institution's educational pro", su_reporting: "No periodic external reporting. The institution must not make substantial misrepresentations to prospective students, students, or the public. Dept of Education investigates complaints.", su_deadlinenarrative: "", su_resourcelabel: "Consumer Information", su_resourceurl: "https://www.syracuse.edu/consumer-information/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "jmhasenw@syr.edu", su_name: "Julie Hasenwinkel", su_email: "jmhasenw@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 213, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "15", su_functioncode: "15", su_name: "Net Price Calculator", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "20 U.S. Code § 1015a - Transparency in college tuition for consumers", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1015a", su_description: "Any institution that receives Title IV funds must post on the institution's website a net price calculator to help current and prospective students estimate their individual net price at that institution as well as other financial aid information. Such calculator may be developed by the Department or the institution if it meets, at a minimum, the same data elements as the Department's. Estimates o", su_reporting: "Net price calculator must be posted on institution website. No periodic external filing; Dept of Education may audit compliance.", su_deadlinenarrative: "", su_resourcelabel: "Net Price Calculator - Syracuse University", su_resourceurl: "https://www.syracuse.edu/admissions-aid/tuition-fees/undergraduate-costs/net-price-calculator/", su_executiveowner: Blank(), su_unitowner: Blank(), su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 236, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "16", su_functioncode: "16", su_name: "Standard of Care", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "HEA § 487(a)(25); 34 C.F.R. § 601.21", su_statuteurl: "https://www.gpo.gov/fdsys/pkg/PLAW-110publ315/pdf/PLAW-110publ315.pdf", su_description: "The university and any of its third-party servicers act as a fiduciary in administering Title IV, HEA programs. Failure to administer the program or account for the funds received under that program in accordance with the highest standard of care and diligence constitutes grounds for: 1) An emergency action; 2) a fine (up to $27,500 per violation); or 3) limitation, suspension, or termination of t", su_reporting: "Standard of care must be published and made available to students. No periodic external filing.", su_deadlinenarrative: "", su_resourcelabel: "Office of Compliance", su_resourceurl: "https://finance.syr.edu/office-of-compliance/", su_executiveowner: {su_compliancedirectoryid: "lpagnew@syr.edu", su_name: "Lois Agnew", su_email: "lpagnew@syr.edu", su_unit: "Syracuse University"}, su_unitowner: Blank(), su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 259, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "17", su_functioncode: "17", su_name: "Textbook Information", su_riskarea: {su_riskareaid: "T01", su_name: "Academic and Faculty Affairs"}, su_domain: {su_domainid: "A003", su_name: "Consumer Information"}, su_risk: "", su_statute: "Higher Education Act", su_citation: "HEOA § 112; 20 U.S.C. § 1015b", su_statuteurl: "https://www.law.cornell.edu/uscode/text/20/1015b", su_description: "Requires disclosure of the course schedule along with the International Standard Book Number (ISBN) of every required and recommended textbook and supplemental material and retail price information to all prospective and enrolled students.", su_reporting: "No deadline is mandated, but October 1 annually is suggested.", su_deadlinenarrative: "October 1 annually (no deadline mandated; suggested)", su_resourcelabel: "Important Syllabus Reminders - Academic Affairs", su_resourceurl: "https://academicaffairs.syracuse.edu/important-syllabus-reminders/", su_executiveowner: Blank(), su_unitowner: {su_compliancedirectoryid: "kmnieder@syr.edu", su_name: "Kelly Campbell", su_email: "kmnieder@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: Blank(), su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 282, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false},
    {su_compliancefunctionid: "406", su_functioncode: "406", su_name: "Revenue Share Program", su_riskarea: {su_riskareaid: "T03", su_name: "Athletics"}, su_domain: Blank(), su_risk: "Low", su_statute: "", su_citation: "", su_statuteurl: "https://www.ecfr.gov", su_description: "", su_reporting: "", su_deadlinenarrative: "", su_resourcelabel: "University Policies", su_resourceurl: "https://policies.syr.edu", su_executiveowner: {su_compliancedirectoryid: "brblair@syr.edu", su_name: "Bryan Blair", su_email: "brblair@syr.edu", su_unit: "Syracuse University"}, su_unitowner: {su_compliancedirectoryid: "mttravis@syr.edu", su_name: "Megan Travis", su_email: "mttravis@syr.edu", su_unit: "Syracuse University"}, su_complianceowner: {su_compliancedirectoryid: "mttravis@syr.edu", su_name: "Megan Travis", su_email: "mttravis@syr.edu", su_unit: "Syracuse University"}, su_opengapcount: 0, su_nextduedate: DateAdd(Today(), 305, TimeUnit.Days), su_lastreviewed: DateAdd(Today(), -30, TimeUnit.Days), su_isflagged: false}
