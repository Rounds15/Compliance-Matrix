// ---- Brand theme -------------------------------------------------
Set(
    gblTheme,
    {
        // Primary
        Orange:       RGBA(247, 105,   0, 1),   // PMS 158C
        Navy:         RGBA(  0,  14,  84, 1),   // PMS 281C - primary blue
        White:        RGBA(255, 255, 255, 1),

        // Secondary orange
        OrangeMedium: RGBA(255,  67,  27, 1),   // PMS 2028C
        OrangeLight:  RGBA(255, 142,   0, 1),   // PMS 130C
        OrangeDark:   RGBA(215,  65,   0, 1),   // PMS 1665C - link colour, WCAG AA on white

        // Secondary blue
        BlueMedium:   RGBA( 32,  50, 153, 1),   // PMS 2728C
        BlueLight:    RGBA( 43, 114, 215, 1),   // PMS 2915C

        // Neutrals
        GrayDark:     RGBA( 64,  64,  64, 1),   // body copy on white
        GrayMid:      RGBA(112, 119, 128, 1),   // PMS Cool Gray 9C
        GrayLight:    RGBA(173, 179, 184, 1),   // PMS Cool Gray 7C
        Border:       RGBA(226, 229, 234, 1),
        BorderSoft:   RGBA(238, 240, 244, 1),
        Surface:      RGBA(250, 251, 253, 1),

        // Risk ratings - shared by functions, assessments, and gap
        // severity. Three levels, matching the su_risklevel choice
        // set: High / Moderate / Low. Unrated is its own colour
        // because su_risk is Recommended, not Required, and is empty
        // on most rows today - a blank must read as "not yet rated"
        // rather than falling through to Low.
        High:         RGBA(220,  38,  38, 1),   //
        Moderate:     RGBA(217, 119,   6, 1),   //
        Low:          RGBA( 22, 163,  74, 1),   //
        Unrated:      RGBA(173, 179, 184, 1),

        // Type
        FontDisplay:  "Verdana",
        FontBody:     "Verdana"
    }
);

// ---- Fiscal calendar ---------------------------------------------
Set(gblFiscalStartMonth, 7);
Set(gblToday, Today());

// =================================================================
// MOCKUP MODE - no Dataverse
// =================================================================
// Every ds* collection below stands in for a Dataverse table so the
// screens run in Studio with nothing connected. Generated by
// tools/build_mockup.py from a slice of the real seed; do not hand
// edit, regenerate instead.
//
// Risk on the first three functions is forced to High / Moderate /
// Low so all three pill colours are visible; the rest keep their
// real value, which is mostly blank and renders as Unrated. One
// deadline is Event-Relative so the "No fixed date" state shows.
// =================================================================

