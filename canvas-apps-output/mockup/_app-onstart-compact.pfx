// ---- Signed-in user ------------------------------------------------
// Pinned to a seeded person so "Assigned to you" is populated for anyone.
Set(gblMe, First(dsDirectory));
Set(gblRole, "Administrator");
Set(gblIsAdmin, true);

// ---- Session state -------------------------------------------------
// gblMenu drives cmp_NavMenus.Visible and is read before any screen
// OnVisible runs, so it has to exist here.
Set(gblMenu, "");
Set(gblSelectedFunction, First(dsFunctions));
Set(gblOpenGapCount, CountRows(Filter(dsGaps, su_status <> "Closed")));
Set(
    gblFilter,
    {Query: "", Topic: "All", Risk: "All", Area: "All"}
);
