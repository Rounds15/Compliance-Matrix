{
  // ---- Canvas app sources -------------------------------------------------
  // .fx.yaml files are YAML documents whose values are Power Fx formulas.
  // Two things matter: they must stay 4-space indented (pac canvas pack is
  // strict about it), and the trailing whitespace inside multi-line formulas
  // must survive, so trimming is disabled for YAML only.
  "[yaml]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.autoIndent": "keep",
    "files.trimTrailingWhitespace": false,
    "editor.quickSuggestions": { "strings": false }
  },

  "files.associations": {
    "*.fx.yaml": "yaml"
  },

  // Schema validation for the files we control the shape of. The canvas
  // .fx.yaml files are deliberately excluded: Microsoft does not publish a
  // JSON schema for them, and a wrong one produces noisy false errors.
  "yaml.schemas": {},
  "yaml.validate": true,
  "yaml.format.enable": false,

  // ---- Generated output ---------------------------------------------------
  // solution/src is regenerated by tools/build_solution.py on every build.
  // Hidden from search and quick-open so it does not bury hand-written source.
  "search.exclude": {
    "solution/src/**": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "solution/src/**": true
  },

  // ---- Python -------------------------------------------------------------
  "python.analysis.extraPaths": ["tools"],

  // ---- Misc ---------------------------------------------------------------
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "editor.rulers": [80]
}
