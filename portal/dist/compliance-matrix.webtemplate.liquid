{% comment %}
  Compliance Matrix - Power Pages web template.

  Paste into Portal Management > Web Templates > "Compliance Matrix" > Source.
  Its page template must have "Use Website Header and Footer" UNCHECKED: this
  template renders the whole document, because the page brings the app's own
  header and navigation. The rest of the site uses the CM Site Header and CM
  Site Footer templates (site-header / site-footer), which match it; the
  site's web links are handed to the page below so it can link back out.

  Everything the page needs is read here, server-side, and handed to the
  script on #cm-root's data- attributes:

    who is signed in        user.emailaddress1, user.fullname, user.id
    administrator?          holds the web role named by the site setting
                            ComplianceMatrix/AdminWebRole (default below)
    who else is one         for the View as preview, administrators only:
                            the members of that web role, read with
                            fetchxml (table permissions apply, so this
                            lists everyone only where administrators can
                            read contacts), plus the emails in the site
                            setting ComplianceMatrix/Administrators
    backend + endpoints     site settings, all under ComplianceMatrix/

  None of that is a security boundary. Administrator screens are hidden from
  everyone else, but what actually stops a write is the table permission
  (Dataverse) or the flow's web-role assignment (SharePoint).

  Signed-out visitors get the CM Sign In web template instead of the matrix.

  4a3f7209d6a0 is replaced by the build with a hash of the two web files, so a
  new upload is never served from a stale browser cache.
{% endcomment %}{% assign cm_admin_role = settings['ComplianceMatrix/AdminWebRole'] | default: 'Administrators' %}{% assign cm_is_admin = false %}{% if user %}{% for r in user.roles %}{% if r == cm_admin_role %}{% assign cm_is_admin = true %}{% endif %}{% endfor %}{% endif %}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Compliance Matrix | Syracuse University</title>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="{{ settings['ComplianceMatrix/CssUrl'] | default: '/cm-matrix.css' }}?v=4a3f7209d6a0">
</head>
<body>
{% if user %}{% assign cm_site_set = settings['ComplianceMatrix/SiteNavigation'] | default: 'Default' %}{% assign cm_site_nav = weblinks[cm_site_set] %}
{% comment %} administrators only: who holds the administrator web role, as a JSON array of emails, for the View as preview {% endcomment %}{% assign cm_admin_emails = '' %}{% if cm_is_admin %}{% fetchxml cm_admins %}
<fetch distinct="true" top="500">
  <entity name="contact">
    <attribute name="emailaddress1" />
    <link-entity name="powerpagecomponent_mspp_webrole_contact" from="contactid" to="contactid" intersect="true">
      <link-entity name="powerpagecomponent" from="powerpagecomponentid" to="powerpagecomponentid">
        <filter><condition attribute="name" operator="eq" value="{{ cm_admin_role | escape }}" /></filter>
      </link-entity>
    </link-entity>
  </entity>
</fetch>
{% endfetchxml %}{% assign cm_sep = '' %}{% capture cm_admin_emails %}[{% for c in cm_admins.results.entities %}{% if c.emailaddress1 %}{{ cm_sep }}"{{ c.emailaddress1 | replace: '"', '' }}"{% assign cm_sep = ',' %}{% endif %}{% endfor %}]{% endcapture %}{% endif %}
{% comment %} the site's own navigation, so the matrix can link back out to it {% endcomment %}
<template id="cm-site-links">{% if cm_site_nav %}{% for link in cm_site_nav.weblinks %}<a href="{{ link.url | escape }}"{% if link.open_in_new_window %} target="_blank"{% endif %}>{{ link.name | escape }}</a>{% endfor %}{% endif %}</template>
<div id="cm-root"
  data-backend="{{ settings['ComplianceMatrix/Backend'] | default: 'sharepoint' | escape }}"
  data-user-email="{{ user.emailaddress1 | escape }}"
  data-user-name="{{ user.fullname | escape }}"
  data-user-id="{{ user.id | escape }}"
  data-is-admin="{{ cm_is_admin }}"
  data-admin-emails="{{ cm_admin_emails | escape }}"
  data-administrators="{% if cm_is_admin %}{{ settings['ComplianceMatrix/Administrators'] | escape }}{% endif %}"
  data-flow-read="{{ settings['ComplianceMatrix/Flow/Read'] | escape }}"
  data-flow-write="{{ settings['ComplianceMatrix/Flow/Write'] | escape }}"
  data-flow-admin-write="{{ settings['ComplianceMatrix/Flow/AdminWrite'] | escape }}"
  data-flow-find-person="{{ settings['ComplianceMatrix/Flow/FindPerson'] | escape }}"
  data-flow-action="{{ settings['ComplianceMatrix/Flow/Action'] | escape }}"
  data-flow-calendar="{{ settings['ComplianceMatrix/Flow/Calendar'] | escape }}"
  data-dataverse-sets="{{ settings['ComplianceMatrix/Dataverse/EntitySets'] | escape }}"
  data-time-zone="{{ settings['ComplianceMatrix/TimeZone'] | default: 'America/New_York' | escape }}"
  data-cache-minutes="{{ settings['ComplianceMatrix/CacheMinutes'] | default: '5' | escape }}"
  data-compliance-home-url="{{ settings['ComplianceMatrix/ComplianceHomeUrl'] | default: 'https://finance.syr.edu/office-of-compliance/' | escape }}"
  data-policies-url="{{ settings['ComplianceMatrix/PoliciesUrl'] | default: 'https://policies.syr.edu/policies/' | escape }}"
  data-report-concern-url="{{ settings['ComplianceMatrix/ReportConcernUrl'] | default: 'https://finance.syr.edu/office-of-compliance/confidential-hotline/' | escape }}"
  data-power-bi-url="{{ settings['ComplianceMatrix/PowerBIUrl'] | default: 'https://app.powerbi.com' | escape }}"
  data-power-bi-embed-url="{{ settings['ComplianceMatrix/PowerBIEmbedUrl'] | escape }}"></div>
<noscript><p style="font:16px/1.5 Verdana,sans-serif;padding:40px;color:#000E54">The Compliance Matrix needs JavaScript. Turn it on for this site.</p></noscript>
<script src="{{ settings['ComplianceMatrix/JsUrl'] | default: '/cm-matrix.js' }}?v=4a3f7209d6a0" defer></script>
{% else %}
{% comment %} signed out: the branded sign-in card (web template "CM Sign In") {% endcomment %}
{% include 'CM Sign In' %}
{% endif %}
</body>
</html>
